{
  "name": "kush-games",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "homepage": "https://abhi1kush.github.io/kush-games/",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:wasm && npm run build:web",
    "preview": "vite preview",
    "test": "vitest run",
    "e2e": "node e2e/live-check.mjs",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist -t",
    "build:wasm": "node scripts/build-wasm.mjs",
    "build:web": "tsc -b && vite build",
    "test:rust": "cargo test --release --manifest-path wasm/Cargo.toml"
  },
  "dependencies": {
    "chess.js": "^1.4.0",
    "peerjs": "^1.5.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "gh-pages": "^6.3.0",
    "playwright-core": "^1.64.1",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  }
}
